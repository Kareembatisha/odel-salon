{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "odel-salon-admin": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": true,
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "odl",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/odel-salon-admin",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/assets",
              {
                "glob": "**/*",
                "input": "src/brands/odel/assets",
                "output": "assets/brand"
              }
            ],
            "styles": [
              "src/styles/styles.scss",
              "node_modules/primeicons/primeicons.css"
            ],
            "scripts": [],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src",
                "src/brands/odel"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "brand-template": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "src/brands/_template/assets",
                  "output": "assets/brand"
                }
              ],
              "stylePreprocessorOptions": {
                "includePaths": [
                  "src",
                  "src/brands/_template"
                ]
              },
              "fileReplacements": [
                {
                  "replace": "src/brands/odel/brand.ts",
                  "with": "src/brands/_template/brand.ts"
                }
              ]
            },
            "production-brand-template": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                },
                {
                  "replace": "src/brands/odel/brand.ts",
                  "with": "src/brands/_template/brand.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "odel-salon-admin:build:production"
            },
            "development": {
              "buildTarget": "odel-salon-admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "buildTarget": "odel-salon-admin:build",
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    }
  }
}