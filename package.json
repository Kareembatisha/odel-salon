{
  "name": "odel-salon-admin",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:template-brand": "ng build --configuration production,brand-template,production-brand-template",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:providers": "node scripts/check-providers.mjs",
    "check:prod-bundle": "node scripts/check-prod-bundle.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss,json}\""
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^16.0.0",
    "@primeuix/themes": "^2.0.2",
    "primeicons": "^7.0.0",
    "primeng": "^21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^22.9.0",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.15",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.10"
  }
}
